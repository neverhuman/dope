      "secondary_retention_thresholds_vs_A": [0.95, 0.98],
      "donor_aware_bootstrap_draws": 1000
    },
    "equivalence_coverage": {
      "calibration_source": "real_C_95th_percentile",
      "ucb_level": 0.90,
      "metrics": {
        "pred": { "floor": 0.01, "default_kappa_star": 1.25 },
        "lift": { "deciles": 10, "floor": 0.01, "default_kappa_star": 1.25 },
        "calib": { "ece_bins": 15, "floor": 0.01, "default_kappa_star": 1.25 },
        "driver": {
          "cluster_spearman_threshold": 0.70,
          "components": ["grouped_permutation_tv", "ale_l1", "drop_group_coalition"],
          "floor": 0.02,
          "default_kappa_star": 1.25
        }
      },
      "selection_transfer_s_deploy": {
        "roster_size": 24,
        "max_regret_above_B": 0.01
      }
    },
    "realism_coverage": {
      "c2st_auc_max": 0.70,
      "c2st_auc_strict": 0.65,
      "marg_auc_max": 0.60,
      "rule_violation_ratio_max": 2.0
