{
  "format": "dope-fidelity-contract",
  "contract_id": "dope-fidelity/v3",
  "version": 3,
  "status": "candidate",
  "protocol_frozen": false,
  "certified": false,
  "composite_score": "forbidden",
  "preparation": {
