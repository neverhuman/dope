    "raw_retention_clipping": "none"
  },
  "gates": {
    "validity_and_empirical_privacy": {
      "illegal_rows_max": 0,
      "support_floor_k": 10,
      "dcr_share_max": 0.55,
      "mia_auc_max": 0.55,
      "mia_tpr_at_1pct_fpr_max": 0.02,
      "formal_dp_claim": "not_claimed",
      "hipaa_deidentification_claim": "not_claimed"
    },
    "parity_coverage": {
      "primary_reference": "fresh_real_twin_B",
