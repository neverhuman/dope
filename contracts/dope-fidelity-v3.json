  },
  "confirmation_claim": {
    "min_sealed_physical_families": 90,
    "family_cluster_bootstrap_draws": 10000,
    "ci_level": 0.95,
    "multiplicity_adjustment": "holm_bonferroni_step_down",
    "must_beat_authentic_rivals_and_plus_teacher_controls": true,
    "require_excluded_nonlinear_auditor_direction_agreement": true,
    "byte_frontier_cap_bytes": 65536,
    "byte_frontier_comparator": "rows_wire_v2"
