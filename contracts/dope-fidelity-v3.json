    "matched": {
      "name": "matched",
      "default_row_multiplier": 1,
      "always_reported": true
    },
    "distill": {
      "name": "distill",
      "default_row_multiplier": 4,
      "utility_only": true,
      "emits_sidecars": ["weight", "pair_id"]
    }
  },
  "informative_cell_rules": {
    "min_relative_real_gain": 0.01,
    "require_real_gain_lcb_gt_zero": true,
