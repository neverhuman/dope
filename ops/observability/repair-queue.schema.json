{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOPE audit repair queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "report_fingerprint", "findings"],
  "properties": {
    "format": {"const": "dope-audit-repair-queue"},
    "version": {"const": 1},
    "report_fingerprint": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "check_id", "severity", "path", "repair_hint", "rerun_command"],
        "properties": {
          "fingerprint": {"type": "string"},
          "check_id": {"type": "string"},
          "severity": {"type": "string"},
          "path": {"type": "string"},
          "repair_hint": {"type": "string"},
          "rerun_command": {"type": "string"}
        }
      }
    }
  }
}
