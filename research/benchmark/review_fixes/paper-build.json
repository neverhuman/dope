        "docs/whitepaper/generated/review-seeds-existing.tex",
        "docs/whitepaper/generated/review-size-retention.tex",
        "docs/whitepaper/generated/review-tost.tex",
        "docs/whitepaper/figures/review-retention-se.pdf"
      ],
      "path": "docs/whitepaper/scripts/review_emit.py"
    },
    {
      "args": [
        "--from-panel",
        "research/benchmark/results/review-fixes-controls-v1/panel.json"
      ],
      "check_args": [
