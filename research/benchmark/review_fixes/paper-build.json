      ],
      "check_args": [
        "--check"
      ],
      "outputs": [
        "docs/whitepaper/generated/review-wave2.json",
        "docs/whitepaper/generated/review-wave2-numbers.tex",
        "docs/whitepaper/generated/review-wave2-size-retention.tex"
      ],
      "path": "docs/whitepaper/scripts/review_wave2.py"
    }
