{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "dope-kernel-compile-report"
    },
    "version": {
      "const": 3
    },
    "release_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "tier": {
          "const": "l3"
        },
        "maximum_artifact_bytes": {
          "const": 10240
        },
        "require_formal_dp": {
          "const": false
        }
      },
      "required": [
        "version",
        "tier",
        "maximum_artifact_bytes",
        "require_formal_dp"
      ]
    },
    "release_policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "enum": [
        "regression",
        "binary"
      ]
    },
    "rows": {
      "type": "integer",
      "minimum": 0
    },
    "positional_features": {
      "type": "integer",
      "minimum": 0
    },
    "selected_candidate": {
      "const": "compact_neural_residual_symbolic"
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "effective_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "bits_per_original_cell": {
      "type": "number",
      "minimum": 0
    },
    "compliant": {
      "const": false
    },
    "failed_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "utility",
          "driver",
          "production_evidence_unmeasured",
          "artifact_bytes"
        ]
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "frontier_count": {
      "type": "integer",
      "minimum": 0
    },
    "beam_width": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "contains_row_payloads": {
      "const": false
    },
    "contains_row_references": {
      "const": false
    }
  },
  "required": [
    "format",
    "version",
    "release_policy",
    "release_policy_hash",
    "task",
    "rows",
    "positional_features",
    "selected_candidate",
    "artifact_bytes",
    "effective_bytes",
    "bits_per_original_cell",
    "compliant",
    "failed_gates",
    "candidate_count",
    "frontier_count",
    "beam_width",
    "elapsed_seconds",
    "contains_row_payloads",
    "contains_row_references"
  ]
}
