{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News q10 DOPE five-fit-seed pilot validation",
  "type": "object",
  "required": ["format", "version", "scope", "source_sha256", "l3_byte_cap", "configuration", "locks", "packed_sample_checks_exact", "common_metric_replays_exact", "fit_cost", "cells", "fit_summary", "summary", "notes", "official_tests_opened", "mfs_v2", "ptf_v1", "production_certified"],
  "properties": {
    "format": {"const": "dope-pilot24-news-q10-fivefit-validation"},
    "version": {"const": 1},
    "scope": {"const": "training_derived_validation_only"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "l3_byte_cap": {"const": 10240},
    "configuration": {
      "type": "object",
      "required": ["binary_sha256", "candidate", "dataset", "fit_deadline_seconds", "probe_source_sha256", "projection_sha256", "split", "structural_penalty", "target_weight", "tier", "train_sha256", "validation_sha256"],
      "properties": {
        "binary_sha256": {"$ref": "#/$defs/hash"},
        "candidate": {"const": "symbolic_autoregressive_residual"},
        "dataset": {"const": "News"},
        "fit_deadline_seconds": {"const": 600},
        "probe_source_sha256": {"$ref": "#/$defs/hash"},
        "projection_sha256": {"$ref": "#/$defs/hash"},
        "split": {"type": "object", "required": ["train", "validation"], "additionalProperties": {"$ref": "#/$defs/hash"}},
        "structural_penalty": {"const": 0.0},
        "target_weight": {"const": 2.0},
        "tier": {"const": "l3"},
        "train_sha256": {"$ref": "#/$defs/hash"},
        "validation_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "locks": {
      "type": "object",
      "required": ["old_sample_round", "seed11_packed_round", "seed23_packed_round", "new_sample_round", "seed11_packing_source", "new_sampling_source", "old_metric_replay_round", "fivefit_replay_source", "old_new_exact_manifest", "new_validation_round", "new_metric_source", "new_validation_manifest", "prior_packed_seed23_report", "first_packing_failure"],
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "packed_sample_checks_exact": {"const": 60},
    "common_metric_replays_exact": {"const": 30},
    "fit_cost": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["fit_seed", "fit_receipt_sha256", "raw_artifact_bytes", "packed_artifact_bytes", "gpu_host", "gpu_elapsed_seconds", "peak_gpu_used_mib", "energy_joules_estimate"],
        "properties": {
          "fit_seed": {"enum": [11, 23, 37, 53, 71]},
          "fit_receipt_sha256": {"$ref": "#/$defs/hash"},
          "raw_artifact_bytes": {"type": "integer", "exclusiveMinimum": 10240},
          "packed_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 10240},
          "gpu_host": {"type": "string", "minLength": 1},
          "gpu_elapsed_seconds": {"type": "number", "minimum": 0, "maximum": 600},
          "peak_gpu_used_mib": {"type": "number", "minimum": 0, "maximum": 16384},
          "energy_joules_estimate": {"type": ["number", "null"]}
        }
      }
    },
    "cells": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["fit_seed", "sample_seed", "size_multiplier", "packed_artifact_bytes", "within_l3_bytes", "catboost_retention", "linear_retention", "mlp_retention", "mlp_informative", "mlp_low_signal_noninferior", "marginal_ks_mean", "pair_correlation_fidelity", "c2st_auc", "exact_copies", "near_copies", "real_vs_real_control_counts", "release_safe", "packed_sample_check_sha256", "metric_receipt_sha256", "metric_replay_sha256"],
        "properties": {
          "fit_seed": {"enum": [11, 23, 37, 53, 71]},
          "sample_seed": {"enum": [101, 211, 307]},
          "size_multiplier": {"enum": [1, 4]},
          "packed_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 10240},
          "within_l3_bytes": {"const": true},
          "catboost_retention": {"type": "number"},
          "linear_retention": {"type": ["number", "null"]},
          "mlp_retention": {"type": ["number", "null"]},
          "mlp_informative": {"type": "boolean"},
          "mlp_low_signal_noninferior": {"type": ["boolean", "null"]},
          "marginal_ks_mean": {"type": "number"},
          "pair_correlation_fidelity": {"type": "number"},
          "c2st_auc": {"type": "number"},
          "exact_copies": {"type": "integer", "minimum": 0},
          "near_copies": {"type": "integer", "minimum": 0},
          "real_vs_real_control_counts": {"type": "object", "required": ["exact", "near"], "properties": {"exact": {"type": "integer", "minimum": 0}, "near": {"type": "integer", "minimum": 0}}},
          "release_safe": {"type": "null"},
          "packed_sample_check_sha256": {"$ref": "#/$defs/hash"},
          "metric_receipt_sha256": {"$ref": "#/$defs/hash"},
          "metric_replay_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "fit_summary": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["fit_seed", "size_multiplier", "sample_seeds", "median_catboost_retention", "min_catboost_retention", "max_catboost_retention", "packed_artifact_bytes", "cells_with_exact_copies", "cells_with_near_copies"],
        "properties": {
          "fit_seed": {"enum": [11, 23, 37, 53, 71]},
          "size_multiplier": {"enum": [1, 4]},
          "sample_seeds": {"const": 3},
          "median_catboost_retention": {"type": "number"},
          "min_catboost_retention": {"type": "number"},
          "max_catboost_retention": {"type": "number"},
          "packed_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 10240},
          "cells_with_exact_copies": {"type": "integer", "minimum": 0, "maximum": 3},
          "cells_with_near_copies": {"type": "integer", "minimum": 0, "maximum": 3}
        }
      }
    },
    "summary": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["size_multiplier", "fit_seeds", "sample_seeds_per_fit", "median_of_fit_medians_catboost_retention", "min_fit_median_catboost_retention", "max_fit_median_catboost_retention", "packed_artifacts_within_l3"],
        "properties": {
          "size_multiplier": {"enum": [1, 4]},
          "fit_seeds": {"const": 5},
          "sample_seeds_per_fit": {"const": 3},
          "median_of_fit_medians_catboost_retention": {"type": "number"},
          "min_fit_median_catboost_retention": {"type": "number"},
          "max_fit_median_catboost_retention": {"type": "number"},
          "packed_artifacts_within_l3": {"const": 5}
        }
      }
    },
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "official_tests_opened": {"const": false},
    "mfs_v2": {"type": "null"},
    "ptf_v1": {"type": "null"},
    "production_certified": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
