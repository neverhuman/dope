{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOPE conditional GPU validation refinement",
  "type": "object",
  "required": [
    "format",
    "version",
    "scope",
    "rounds",
    "cells",
    "summary",
    "symbolic_reference_cells",
    "symbolic_results_sha256",
    "total_fit_seconds",
    "ptf_v1",
    "mfs_v2",
    "production_certified",
    "official_tests_opened",
    "production_family_selected"
  ],
  "properties": {
    "format": {
      "const": "dope-conditional-gpu-validation"
    },
    "version": {
      "const": 1
    },
    "scope": {
      "const": "validation_only_one_fit_seed_one_sample_seed_n_rows"
    },
    "rounds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "revision",
          "stage",
          "path",
          "sha256",
          "binary_sha256",
          "source_manifest_path",
          "source_manifest_sha256",
          "fit_compute_ceiling_seconds"
        ]
      }
    },
    "cells": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "required": [
          "revision",
          "stage",
          "dataset",
          "candidate",
          "fit_seed",
          "sample_seed",
          "status",
          "host",
          "artifact_bytes",
          "artifact_sha256",
          "fit_seconds",
          "peak_gpu_used_mib",
          "energy_joules_estimate",
          "cell_path",
          "cell_sha256",
          "attempt_path",
          "attempt_sha256",
          "metric_sha256",
          "common_validation"
        ],
        "properties": {
          "revision": {
            "enum": [
              "original",
              "readout_refit"
            ]
          },
          "stage": {
            "enum": [
              "discovery",
              "confirmation"
            ]
          },
          "dataset": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "candidate": {
            "enum": [
              "compact_neural_residual_symbolic",
              "symbolic_autoregressive_residual"
            ]
          },
          "fit_seed": {
            "const": 11
          },
          "sample_seed": {
            "const": 101
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "memory_limit",
              "resource_monitor_failed"
            ]
          },
          "host": {
            "type": "string"
          },
          "artifact_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "artifact_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fit_seconds": {
            "type": "number",
            "minimum": 0
          },
          "peak_gpu_used_mib": {
            "type": "integer",
            "minimum": 0
          },
          "energy_joules_estimate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cell_path": {
            "type": "string"
          },
          "cell_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt_path": {
            "type": "string"
          },
          "attempt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metric_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "common_validation": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "utility",
              "copy_counts",
              "real_vs_real_control_counts",
              "marginal_ks_mean",
              "c2st_auc"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "symbolic_reference_cells": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12
    },
    "symbolic_results_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "total_fit_seconds": {
      "type": "number",
      "minimum": 0
    },
    "ptf_v1": {
      "type": "null"
    },
    "mfs_v2": {
      "type": "null"
    },
    "production_certified": {
      "const": false
    },
    "official_tests_opened": {
      "const": false
    },
    "production_family_selected": {
      "const": false
    }
  },
  "additionalProperties": false
}
