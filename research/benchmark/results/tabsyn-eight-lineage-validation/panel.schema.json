{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained validation diagnostic panel",
  "type": "object",
  "required": ["format", "version", "receipt_lock_ref", "source_refs", "cells", "summary", "sample_cells", "lineages", "selection_use", "production_certified", "official_tests_opened", "mfs_v2", "ptf_v1", "release_safe_l3", "superiority"],
  "properties": {
    "format": {"const": "dope-retained-validation-panel"},
    "version": {"const": 1},
    "sample_cells": {"type": "integer", "minimum": 1},
    "lineages": {"type": "integer", "minimum": 1},
    "comparison_scope": {"const": "training_derived_validation_only"},
    "selection_use": {"const": false},
    "production_certified": {"const": false},
    "official_tests_opened": {"const": false},
    "mfs_v2": {"type": "null"},
    "ptf_v1": {"type": "null"},
    "release_safe_l3": {"type": "null"},
    "superiority": {"type": "null"},
    "receipt_lock_ref": {"$ref": "#/$defs/ref"},
    "source_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}},
    "summary": {"type": "array", "minItems": 1},
    "cells": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["job_sha256", "dataset", "method", "fit_seed", "sample_seed", "row_multiplier", "charged_artifact_bytes", "metrics", "receipt_ref", "input_hashes", "official_tests_opened", "mfs_v2", "ptf_v1", "release_safe_l3", "superiority"],
        "properties": {
          "job_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dataset": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "method": {"type": "string"},
          "fit_seed": {"type": "integer"},
          "sample_seed": {"enum": [101, 211, 307]},
          "row_multiplier": {"enum": [1, 4]},
          "charged_artifact_bytes": {"type": "integer", "minimum": 1},
          "receipt_ref": {"$ref": "#/$defs/ref"},
          "official_tests_opened": {"const": false},
          "mfs_v2": {"type": "null"}, "ptf_v1": {"type": "null"},
          "release_safe_l3": {"type": "null"}, "superiority": {"type": "null"}
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object", "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
