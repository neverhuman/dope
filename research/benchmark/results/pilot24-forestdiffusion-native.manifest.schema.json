            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "pilot24-forestdiffusion-native.md": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "pilot24-forestdiffusion-native.pdf": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "pilot24-forestdiffusion-native.schema.json": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "pilot24-forestdiffusion-native.svg": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        }
