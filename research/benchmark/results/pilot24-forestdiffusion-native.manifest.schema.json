      "additionalProperties": false,
      "properties": {
        "pilot24-forestdiffusion-native.csv": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "bytes",
            "sha256"
          ],
          "type": "object"
        },
        "pilot24-forestdiffusion-native.json": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
