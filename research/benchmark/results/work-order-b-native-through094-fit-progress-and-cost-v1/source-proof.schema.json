{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_execution": {
      "const": "stdlib metadata projection and AST parsing only; no publisher, controls, schema initializer, host or science execution"
    },
    "format": {
      "const": "native-through094-rights-safe-source-proof-v1"
    },
    "private_input_join_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "file": {
            "enum": [
              "result.json",
              "schema.json",
              "README.md",
              "operation-cost.csv",
              "seed-coverage.csv",
              "table.md",
              "source-proof.schema.json"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "file",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "receipt_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 54,
      "minItems": 54,
      "type": "array"
    },
    "source_snapshot_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": [
    "author_execution",
    "format",
    "private_input_join_sha256",
    "public_files",
    "receipt_refs",
    "source_snapshot_refs"
  ],
  "type": "object"
}
