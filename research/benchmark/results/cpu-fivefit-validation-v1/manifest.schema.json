{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPU replication validation batch manifest",
  "type": "object",
  "required": ["format", "version", "producer_ref", "producer_options", "inputs", "files", "fit_scope", "sample_cells", "common_metrics_complete_for_published_fit_prefix", "full_population_complete", "five_fit_matrix_complete", "native_objectives_changed", "official_tests_opened", "mfs_v2", "ptf_v1", "release_safe_l3", "superiority"],
  "properties": {
    "format": {"const": "dope-cpu-fit-replication-common-validation-batch"},
    "version": {"const": 1},
    "producer_ref": {"$ref": "#/$defs/ref"},
    "producer_options": {"type": "object", "required": ["summarize_by_fit_seed"], "properties": {"summarize_by_fit_seed": {"const": true}}},
    "inputs": {"type": "object", "required": ["arf", "forest"]},
    "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}},
    "fit_scope": {"type": "object", "required": ["arf", "forest"]},
    "sample_cells": {"const": 192},
    "common_metrics_complete_for_published_fit_prefix": {"const": true},
    "full_population_complete": {"const": false},
    "five_fit_matrix_complete": {"const": false},
    "native_objectives_changed": {"const": false},
    "official_tests_opened": {"const": false},
    "mfs_v2": {"type": "null"},
    "ptf_v1": {"type": "null"},
    "release_safe_l3": {"type": "null"},
    "superiority": {"type": "null"}
  },
  "$defs": {
    "ref": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}
  }
}
