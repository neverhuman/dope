  "required": [
    "DOPE_configuration",
    "across_lineage_aggregation",
    "auditor",
    "between_fit_aggregation",
    "cells",
    "comparison_scope",
    "counts_as_DOPE_win",
    "coverage",
    "effective_auditor_seed",
    "exclusions",
    "fit_seed",
    "five_fit_variance_claim",
    "format",
    "gated_scores",
    "historical_full_runtime_closure_upgraded",
    "new_fit_sample_or_evaluation",
    "official_tests_opened",
    "paired_lineage_groups",
    "production_certified",
    "runtime_scope",
    "sample_seeds",
    "size_multipliers",
    "source_scope",
    "status",
    "summary",
    "within_lineage_aggregation",
    "version",
    "panel_id",
