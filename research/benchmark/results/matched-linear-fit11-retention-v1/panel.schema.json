{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "DOPE_configuration": {
      "const": "features12_steps2048"
    },
    "across_lineage_aggregation": {
      "type": "string"
    },
    "artifact_scope": {
      "const": {
        "artifact_bytes_define_production_eligibility": false,
        "charged_bytes_are_model_plus_projection": true,
        "comparison_unconstrained_by_stored_byte_cap": true,
        "stored_byte_threshold_bytes": 10240
      }
    },
    "auditor": {
      "const": "pilot6c_linear_regression"
    },
    "between_fit_aggregation": {
      "type": "null"
    },
    "cells": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "DOPE_charged_artifact_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "DOPE_metric_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "DOPE_retention": {
            "type": [
              "number",
              "null"
            ]
          },
          "TRAIN_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "VAL_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "auditor": {
            "const": "linear"
          },
          "dataset": {
            "pattern": "^[0-9a-f]{16}$",
            "type": "string"
          },
          "effective_auditor_seed": {
            "const": null
          },
          "fit_seed": {
            "const": 11
          },
          "informative": {
            "type": "boolean"
          },
          "null_loss": {
            "type": "number"
          },
          "peer_charged_artifact_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "peer_configuration": {
            "type": "string"
          },
          "peer_method": {
            "type": "string"
          },
          "peer_metric_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "peer_retention": {
            "type": [
              "number",
              "null"
            ]
          },
          "projection_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "real_validation_loss": {
            "type": "number"
          },
          "sample_seed": {
            "enum": [
              101,
              211,
              307
            ]
          },
          "size_multiplier": {
            "enum": [
              1,
              4
            ]
          },
          "task": {
            "const": "regression"
          }
        },
        "required": [
          "DOPE_metric_sha256",
          "DOPE_retention",
          "TRAIN_sha256",
          "VAL_sha256",
          "auditor",
          "dataset",
          "effective_auditor_seed",
          "fit_seed",
          "informative",
          "null_loss",
          "peer_configuration",
          "peer_method",
          "peer_metric_sha256",
          "peer_retention",
          "projection_sha256",
          "real_validation_loss",
          "sample_seed",
          "size_multiplier",
          "task",
          "DOPE_charged_artifact_bytes",
          "peer_charged_artifact_bytes"
        ],
        "type": "object"
      },
      "maxItems": 210,
      "minItems": 210,
      "type": "array"
    },
    "comparison_scope": {
      "const": "official_training_derived_validation_only"
    },
    "cost_scope": {
      "const": {
        "energy": null,
        "hardware": null,
        "logical_aliases_are_independent": false,
        "physical_cost_estimated": false,
        "training_or_campaign_cost": null,
        "wall_seconds": null
      }
    },
    "counts_as_DOPE_win": {
      "const": false
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "CatBoost_or_MLP_cells_pooled": {
          "type": "integer"
        },
        "distinct_DOPE_metric_receipts": {
          "type": "integer"
        },
        "distinct_peer_metric_receipts": {
          "type": "integer"
        },
        "logical_comparator_cells": {
          "type": "integer"
        },
        "projection_tasks_authenticated_as_regression": {
          "type": "integer"
        }
      },
      "required": [
        "CatBoost_or_MLP_cells_pooled",
        "distinct_DOPE_metric_receipts",
        "distinct_peer_metric_receipts",
        "logical_comparator_cells",
        "projection_tasks_authenticated_as_regression"
      ],
      "type": "object"
    },
    "effective_auditor_seed": {
      "type": "null"
