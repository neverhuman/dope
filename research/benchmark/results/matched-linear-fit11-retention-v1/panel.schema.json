    "exclusions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dataset": {
            "type": "string"
          },
          "peer_configuration": {
            "type": "string"
          },
          "peer_method": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "size_multiplier": {
            "type": "integer"
          }
        },
        "required": [
          "dataset",
          "peer_configuration",
          "peer_method",
          "reason",
          "size_multiplier"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "fit_seed": {
      "const": 11
    },
    "five_fit_variance_claim": {
      "const": false
    },
    "format": {
      "const": "measured_descriptive_validation"
    },
    "gated_scores": {
      "additionalProperties": false,
      "properties": {
        "mfs_v2": {
          "type": "null"
        },
        "ptf_v1": {
          "type": "null"
        },
        "release_safe_l3": {
          "type": "null"
        },
        "superiority": {
          "type": "null"
        }
      },
      "required": [
        "mfs_v2",
        "ptf_v1",
        "release_safe_l3",
        "superiority"
      ],
      "type": "object"
    },
    "historical_full_runtime_closure_upgraded": {
      "const": false
    },
    "new_fit_sample_or_evaluation": {
      "const": false
    },
    "official_tests_opened": {
      "const": false
    },
    "paired_lineage_groups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "DOPE_three_sample_mean": {
            "type": "number"
          },
          "dataset": {
            "type": "string"
          },
          "peer_configuration": {
            "type": "string"
          },
          "peer_method": {
            "type": "string"
          },
          "peer_three_sample_mean": {
            "type": "number"
          },
          "size_multiplier": {
            "type": "integer"
          }
        },
        "required": [
          "DOPE_three_sample_mean",
          "dataset",
          "peer_configuration",
          "peer_method",
          "peer_three_sample_mean",
          "size_multiplier"
        ],
        "type": "object"
      },
      "maxItems": 66,
      "minItems": 66,
      "type": "array"
    },
    "panel_id": {
      "const": "matched_linear_fit11_retention_v1"
    },
    "production_certified": {
      "const": false
    },
    "runtime_scope": {
      "type": "string"
    },
    "sample_seeds": {
      "items": {
        "type": "integer"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "size_multipliers": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "source_scope": {
      "type": "string"
    },
    "status": {
      "const": "measured_descriptive_validation"
    },
    "summary": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "DOPE_median_of_same_cohort_three_sample_means": {
            "type": "number"
          },
          "median_paired_difference": {
            "type": "number"
          },
          "paired_complete_informative_lineages": {
            "type": "integer"
          },
          "peer_configuration": {
            "type": "string"
          },
          "peer_median_of_same_cohort_three_sample_means": {
            "type": "number"
