{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeyondArena prepare receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "panel_lock_sha256",
    "official_tests_opened",
    "families"
  ],
  "properties": {
    "format": {"const": "dope-beyondarena-prepare-receipt"},
    "version": {"const": 1},
    "panel_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "official_tests_opened": {"const": false},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "overlap", "width", "other"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
