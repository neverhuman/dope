{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["format", "version", "scope", "round_lock_sha256", "method_lock_sha256", "cells", "aggregate", "ptf_v1", "mfs_v2", "production_certified", "public_or_s3_test_opened"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "dope-benchmark-compact-native-validation"},
    "version": {"const": 1},
    "scope": {"const": "validation_only_one_fit_seed"},
    "round_lock_sha256": {"$ref": "#/$defs/hash"},
    "method_lock_sha256": {"$ref": "#/$defs/hash"},
    "cells": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/cell"}},
    "aggregate": {"type": "object", "required": ["independent_marginals", "Chow-Liu"], "additionalProperties": false,
      "properties": {"independent_marginals": {"$ref": "#/$defs/aggregate"}, "Chow-Liu": {"$ref": "#/$defs/aggregate"}}},
    "ptf_v1": {"type": "null"},
    "mfs_v2": {"type": "null"},
    "production_certified": {"const": false},
    "public_or_s3_test_opened": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "trial": {"type": "object", "additionalProperties": false,
      "required": ["index", "config", "status", "native_kpi", "artifact_bytes", "wall_seconds", "failure_type", "attempt_receipt_path", "attempt_receipt_sha256", "metric_receipt_sha256"],
      "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 7},
        "config": {"type": "object"}, "status": {"enum": ["ok", "failed", "timeout"]},
        "native_kpi": {"type": ["number", "null"]},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0, "maximum": 43200},
        "failure_type": {"type": ["string", "null"]},
        "attempt_receipt_path": {"type": "string", "minLength": 1},
        "attempt_receipt_sha256": {"$ref": "#/$defs/hash"},
        "metric_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}},
    "cell": {"type": "object", "additionalProperties": false,
      "required": ["stage", "dataset", "method", "objective", "selected_trial_index", "selected_native_kpi", "selected_artifact_bytes", "selected_within_l3", "selection_receipt_path", "selection_receipt_sha256", "trials"],
      "properties": {"stage": {"enum": ["discovery", "confirmation"]},
        "dataset": {"$ref": "#/$defs/dataset"},
        "method": {"enum": ["independent_marginals", "Chow-Liu"]},
        "objective": {"const": "mean_log_density"},
        "selected_trial_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "selected_native_kpi": {"type": "number"},
        "selected_artifact_bytes": {"type": "integer", "minimum": 0},
        "selected_within_l3": {"type": "boolean"},
        "selection_receipt_path": {"type": "string", "minLength": 1},
        "selection_receipt_sha256": {"$ref": "#/$defs/hash"},
        "trials": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/trial"}}}},
    "aggregate": {"type": "object", "additionalProperties": false,
      "required": ["cells", "trials", "failed_trials", "selected_within_l3", "trial_wall_seconds"],
      "properties": {"cells": {"const": 12},
        "trials": {"type": "integer", "minimum": 1, "maximum": 96},
        "failed_trials": {"type": "integer", "minimum": 0, "maximum": 96},
        "selected_within_l3": {"type": "integer", "minimum": 0, "maximum": 12},
        "trial_wall_seconds": {"type": "number", "minimum": 0}}}
  }
}
