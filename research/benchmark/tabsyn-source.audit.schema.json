    "fit_command",
    "sample_command",
    "remaining_admission_gaps",
    "method_status",
    "matrix_admission",
    "runtime_closure_verified",
    "fit_sample_contract_verified",
    "native_tuning_complete",
    "reported_experiment_reproductions",
    "new_fits_started",
    "official_tests_opened",
    "mfs_v2",
    "ptf_v1",
    "release_safe_l3",
    "production_certified",
    "counts_as_dope_win"
