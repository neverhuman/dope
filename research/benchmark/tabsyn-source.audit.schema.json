      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_file_count": {
      "const": 96
    },
    "source_inventory": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "source_member_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 96,
      "minProperties": 96,
      "type": "object"
    },
    "source_scope": {
      "const": "96 source/documentation members only; skipped bytecode, images and dataset metadata not read"
    },
    "source_verification": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "upstream_commit": {
      "const": "cb5ac0f74ec36ee88e7a974a393dfbef50d42da7"
    },
    "upstream_url": {
      "const": "https://github.com/amazon-science/tabsyn"
    },
