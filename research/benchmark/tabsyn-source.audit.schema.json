      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "matrix_admission": {
      "const": false
    },
    "method": {
      "const": "TabSyn"
    },
    "method_status": {
      "const": "source_audit_pending"
    },
    "mfs_v2": {
      "const": null
    },
    "native_objective": {
      "const": {
        "auditor_configurations": 36,
        "auditor_grid": {
          "gamma": [
            0.0,
            1.0
          ],
          "max_depth": [
            5,
            10,
            20
          ],
          "min_child_weight": [
            1,
            10
          ],
          "n_estimators": [
            10,
            50,
            100
          ],
          "nthread": [
            -1
          ],
          "objective": [
            "reg:linear"
          ],
          "tree_method": [
            "gpu_hist"
          ]
        },
        "auditor_grid_is_generator_search_space": false,
        "candidate_regression_objective": "best_r2_scores.XGBRegressor.r2",
        "direction": "maximize",
        "generator_search_space": null,
        "generator_tie_breaks": null,
        "implementation": "eval/mle/mle.py::_evaluate_regression",
        "implementation_sha256": "ad8f0e7ad45f4c9da1c7d4c1f1ee2d1989890558e509da94ef8db5d69dc1103a",
        "native_values_cross_method_ranking": false,
        "real_partition_for_future_tuning": "only frozen official-training-derived validation, staged under the author test-named path",
        "selection_behavior": "select auditor parameters by internal synthetic validation R2, then refit and measure on real evaluation partition",
        "shared_kpi_used_for_selection": false,
        "status": "source_identified_not_frozen_for_tuning",
        "synthetic_auditor_validation_rows": "floor(synthetic_row_count / 9); numpy random shuffle",
        "target_transform": "log(clip(y, 1, 20000)) for auditor fit labels and real evaluation labels; internal synthetic validation labels remain untransformed",
        "tuning_seed_policy": null
      }
    },
    "native_tuning_complete": {
      "const": false
    },
    "new_fits_started": {
      "const": 0
    },
    "official_tests_opened": {
      "const": false
