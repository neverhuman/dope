      "const": {
        "installed_runtime_verified": false,
        "python": "3.10",
        "requirements_fully_version_pinned": false,
        "requirements_sha256": "c4e7c5bd0cc34c2a1a0e39482e9399c69e13ccd7703b05371f68dd56e5ef0e33",
        "torch_conda_example": "2.0.1/CUDA11.7"
      }
    },
    "bibliography_entry": {
      "const": "zhang2024mixed"
    },
    "counts_as_dope_win": {
      "const": false
    },
    "default_config": {
      "const": {
        "diffusion": {
          "batch_size": 4096,
          "data_loader_workers": 4,
          "early_stop_patience": 500,
          "hidden_dimension": 1024,
          "learning_rate": 0.001,
          "maximum_epochs": 10001,
          "weight_decay": 0
        },
        "sampling": {
          "cli_steps_forwarded_to_sampler": false,
          "num_steps": 50,
          "rows": "training latent row count"
        },
        "vae": {
          "attention_heads": 1,
          "batch_size": 4096,
          "beta_decay": 0.7,
          "data_loader_workers": 4,
          "epochs": 4000,
          "factor": 32,
          "learning_rate": 0.001,
          "max_beta": 0.01,
          "min_beta": 1e-05,
          "token_dimension": 4,
          "transformer_layers": 2,
          "weight_decay": 0
        }
      }
    },
    "fit_command": {
      "const": "python main.py --dataname DATASET --method vae --mode train; python main.py --dataname DATASET --method tabsyn --mode train"
    },
    "fit_sample_contract_verified": {
      "const": false
    },
    "format": {
      "const": "dope-tabsyn-source-admission-audit"
    },
    "license": {
      "const": "Apache-2.0"
    },
