{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:campaign:v1",
  "title": "Frozen transfer campaign roster and attempt ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "roster",
    "roster_sha256",
    "policies",
    "resource_caps",
    "attempts"
  ],
  "properties": {
    "format": {
      "const": "dope-transfer-campaign"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "roster": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "task",
          "method",
          "budget",
          "fitseed",
          "drawseed",
          "auditor",
          "auditorseed",
          "endpoint",
          "sample_size",
          "sample_policy",
          "context_policy"
        ],
        "properties": {
          "task": {},
          "method": {},
          "budget": {},
          "fitseed": {},
          "drawseed": {},
          "auditor": {},
          "auditorseed": {},
          "endpoint": {},
          "cell_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          },
          "sample_policy": {
            "enum": [
              "primary",
              "sensitivity_4n"
            ]
          },
          "context_policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roster_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policies": {
      "type": "object"
    },
    "resource_caps": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "run_id",
          "cell_id",
          "parent_attempt_id",
          "original_failure",
          "retry_authorized",
          "status",
          "requested_rows",
          "produced_rows",
          "provided_rows",
          "consumed_rows",
          "wall_ms",
          "cpu_ms",
          "gpu_ms",
          "residency_ms",
          "peak_ram_bytes",
          "peak_vram_bytes",
          "disk_bytes",
          "cost_basis",
          "run_pins"
        ],
        "properties": {
          "requested_rows": {
            "type": "integer",
            "minimum": 0
          },
          "produced_rows": {
            "type": "integer",
            "minimum": 0
          },
          "provided_rows": {
            "type": "integer",
            "minimum": 0
          },
          "consumed_rows": {
            "type": "integer",
            "minimum": 0
          },
          "wall_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cpu_ms": {
            "type": "integer",
            "minimum": 0
          },
          "gpu_ms": {
            "type": "integer",
            "minimum": 0
          },
          "residency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "peak_ram_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "peak_vram_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "disk_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parent_attempt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "retry_authorized": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "completed",
              "timeout",
              "oom",
              "unsupported",
              "license_denied",
              "missing",
              "invalid",
              "cancelled",
              "unresolved"
            ]
          },
          "cost_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wall",
              "cpu",
              "gpu",
              "residency",
              "disk"
            ],
            "properties": {
              "wall": {
                "type": "string",
                "minLength": 1
              },
              "cpu": {
                "type": "string",
                "minLength": 1
              },
              "gpu": {
                "type": "string",
                "minLength": 1
              },
              "residency": {
                "type": "string",
                "minLength": 1
              },
              "disk": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "run_pins": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent_hashes",
              "toolchain_sha256",
              "command_sha256",
              "budget_sha256"
            ],
            "properties": {
              "parent_hashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "toolchain_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "command_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "budget_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
