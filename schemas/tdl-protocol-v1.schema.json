{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "contract_id",
    "version",
    "protocol_family",
    "metric_name",
    "status",
    "protocol_frozen",
    "certified",
    "parent_contract_id",
    "parent_contract_sha256",
    "protocol_id",
    "canonicalization",
    "identity_fields",
    "workload",
    "roles",
    "panel",
    "losses",
    "transforms",
    "seeds",
    "byte_grid_bytes",
    "transfer",
    "calibration",
    "inference",
    "multiplicity",
    "release_profiles",
    "applicability",
    "comparison_plan",
    "state_axes"
  ],
  "properties": {
    "format": {
      "const": "dope-tdl-protocol"
    },
    "contract_id": {
      "const": "tdl-contract-v2.candidate"
    },
    "version": {
      "const": 2
    },
    "protocol_family": {
      "const": "task-tdl"
    },
    "metric_name": {
      "const": "TDL"
    },
    "status": {
      "const": "candidate"
    },
    "protocol_frozen": {
      "const": false
    },
    "certified": {
      "const": false
    },
    "parent_contract_id": {
      "const": "tdl-contract-v1"
    },
    "parent_contract_sha256": {
      "const": "281923c33da12e218d54c2226d138bbea2a22d86936bae5c3d7edfbfaf2c63ab"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^protocol:[0-9a-f]{64}$"
    },
    "canonicalization": {
      "const": "dope-canonical-json-v1"
    },
    "identity_fields": {
      "const": {
        "task": [
          "source_sha256",
          "workload_sha256",
          "target_sha256",
          "prepared_view_sha256",
          "split_sha256"
        ],
        "method": [
          "implementation_sha256",
          "recipe_sha256",
          "environment_sha256"
        ],
        "panel": [
          "models_sha256",
          "roles_sha256"
        ],
        "artifact": [
          "protocol_id",
          "task_id",
          "method_id",
          "payload_sha256",
          "closure_sha256"
        ],
        "campaign": [
          "protocol_id",
          "panel_id",
          "schedule_sha256",
          "source_roster_sha256"
        ],
        "release_profile": [
          "policy_sha256",
          "rights_sha256",
          "privacy_profile_sha256"
        ]
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_roster",
        "task_roster"
      ],
      "properties": {
        "source_roster": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          ]
        },
        "task_roster": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^task:[0-9a-f]{64}$"
              }
            }
          ]
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "confirmation"
      ],
      "properties": {
        "development": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          ]
        },
        "confirmation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          ]
        }
      }
    },
    "panel": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_families",
            "eligible_models"
          ],
          "properties": {
            "required_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "tree",
                  "linear",
                  "neural",
                  "foundation_tabular"
                ]
              }
            },
            "eligible_models": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "family",
                  "role"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "family": {
                    "type": "string",
                    "enum": [
                      "tree",
                      "linear",
                      "neural",
                      "foundation_tabular"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "development",
                      "confirmation"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "losses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regression",
        "binary",
        "multiclass",
        "raw_transfer_clipping"
      ],
      "properties": {
        "regression": {
          "const": "squared_error_original_units"
        },
        "binary": {
          "const": "log_loss"
        },
        "multiclass": {
          "const": "log_loss"
        },
        "raw_transfer_clipping": {
          "const": "none"
        }
      }
    },
