{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:privacy-evidence:v1",
  "title": "Unqualified calibrated empirical membership measurement",
  "description": "Aggregate local measurements. Hashes are commitments; custody, attack coverage, controls and application margins require independent qualification. No formal privacy, legal route or release authorization follows. Runtime additionally validates rate/count consistency, ordered bounds and low-FPR resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "status",
    "reasons",
    "attack",
    "calibration_sha256",
    "recipe_sha256",
    "policy_sha256",
    "evaluation_sha256",
    "threat_sha256",
    "ledger_sha256",
    "artifact_inventory_sha256",
    "raw_auc",
    "oriented_auc",
    "reversible_diagnostic_auc",
    "tpr",
    "fpr",
    "low_fpr_target",
    "attacker_prior",
    "confidence",
    "advantage",
    "auc_bounds",
    "tpr_bounds",
    "fpr_bounds",
    "advantage_bounds",
    "low_fpr_resolved",
    "true_positives",
    "false_positives",
    "members",
    "nonmembers",
    "independent_units",
    "comparisons",
    "formal_dp",
    "legal_route",
    "release_authorized"
  ],
  "properties": {
    "format": {
      "const": "dope-privacy-evidence"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "const": "inconclusive"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "custody_controls_and_policy_unqualified",
          "low_fpr_unresolved",
          "cluster_or_release_inference_required",
          "access_threat_unmeasured"
        ]
      }
    },
    "attack": {
      "const": "calibrated_membership"
    },
    "calibration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "threat_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_auc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "oriented_auc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reversible_diagnostic_auc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tpr": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fpr": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "low_fpr_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attacker_prior": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "advantage": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "auc_bounds": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tpr_bounds": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fpr_bounds": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "advantage_bounds": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "low_fpr_resolved": {
      "type": "boolean"
    },
    "true_positives": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "false_positives": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "members": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "nonmembers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "independent_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "comparisons": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "formal_dp": {
      "const": "unverified"
    },
    "legal_route": {
      "const": "unverified"
    },
    "release_authorized": {
      "const": false
    }
  }
}
