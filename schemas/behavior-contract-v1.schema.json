        "sampling_mode": {
          "enum": [
            "population",
            "teaching_context"
          ]
        },
        "teaching_context_policy_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_grid_kib": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0.5
          }
        },
        "payload_cold_policy": {
          "type": "string",
          "minLength": 1
        },
        "context_sample_policy": {
          "type": "string",
          "minLength": 1
        }
      }
