            "qualification": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "foundation_pretraining": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workload",
            "qualification"
          ],
          "properties": {
            "workload": {
              "type": "string",
              "minLength": 1
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_schema_hash",
        "task_manifest_hash",
        "analytical_workload_hash",
        "population_history_hash",
        "task_kind",
        "loss_space",
        "losses",
        "target_transform_policy",
        "sampling_mode",
        "teaching_context_policy_hash"
      ],
      "properties": {
        "table_schema_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_manifest_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "analytical_workload_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "population_history_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_kind": {
          "enum": [
            "numeric_regression"
