        "losses": {
          "type": "array",
          "items": {
            "enum": [
              "mse",
              "rmse",
              "mae"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_transform_policy": {
          "const": "fit_only_invert_before_loss"
