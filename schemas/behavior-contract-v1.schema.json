  "$id": "urn:dope:behavior-contract:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "status",
    "protocol_frozen",
    "confirmation_allowed",
    "active_production_tier",
    "primary_scope",
    "scopes",
    "workload",
    "endpoints",
    "margins",
    "learners",
    "budgets",
    "disclosure",
    "freeze_requirements",
    "states",
    "release_gate_conjunction",
    "historical_contract_sha256",
    "migration"
