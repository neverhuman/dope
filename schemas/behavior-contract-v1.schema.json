      "properties": {
        "development_fitness": {
          "const": "development-only family/learner-balanced excess risk with declared tail penalty"
        },
        "scientific_endpoint": {
          "const": "paired original-unit risk gap and all-required-cell tolerance coverage"
        },
        "release_authority": {
          "const": "separate scoped authorization and conjunction of applicable verified gates"
        },
        "bytes_policy": {
          "const": "exact serialized sampling bytes are a constraint and a frontier axis"
        },
