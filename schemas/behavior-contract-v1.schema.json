    "format": {
      "const": "dope-behavior-contract"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "protocol_frozen": {
      "type": "boolean"
    },
    "confirmation_allowed": {
      "type": "boolean"
    },
    "active_production_tier": {
      "const": false
    },
    "primary_scope": {
      "enum": [
        "task_replacement",
        "reusable_table",
        "augmentation",
        "relational_replacement",
        "foundation_pretraining"
      ]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_replacement",
        "reusable_table",
        "augmentation",
        "relational_replacement",
        "foundation_pretraining"
      ],
      "properties": {
        "task_replacement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workload",
            "qualification"
          ],
          "properties": {
            "workload": {
              "type": "string",
              "minLength": 1
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reusable_table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workload",
            "qualification"
          ],
          "properties": {
            "workload": {
              "type": "string",
              "minLength": 1
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "augmentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workload",
            "qualification"
          ],
          "properties": {
            "workload": {
              "type": "string",
              "minLength": 1
