{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:learner-roles:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "selection_families",
    "evaluation_required_families",
    "held_out_families"
  ],
  "properties": {
    "format": {"const": "dope-learner-roles"},
    "version": {"const": 2},
    "selection_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evaluation_required_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "held_out_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
