{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/pilot-admission-v1.schema.json",
  "description": "Metadata contract only; schema validity grants no execution, science, custody or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "operation",
    "plan_sha256",
    "pins",
    "gates"
  ],
