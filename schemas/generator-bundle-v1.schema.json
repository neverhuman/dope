{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/generator-bundle-v1.schema.json",
  "title": "Generator bundle manifest v1",
  "description": "Byte inventory only. Required fitted transforms, codebooks, target inverses, selected seeds, prompts, prototypes, priors and adaptations must be declared with actual wire bytes. Runtime/shared labels, hashes and amortization_count do not prove public independence or licensing; recipient accounting fully charges them until qualified. Generated samples are a separate delivery scope; required or reachable rows/evidence remain charged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amortization_count",
    "bundle_id",
    "capabilities",
    "components",
    "format",
    "sampling_handler",
    "transport_framing",
    "version"
  ],
  "properties": {
    "format": {"type": "string", "const": "dope.generator-bundle/v1"},
    "version": {"type": "integer", "const": 1},
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sampling_handler": {
      "type": "string",
      "enum": ["inventory-only", "native-inline-dpk", "native-raw-complete-v1"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["byte-inventory", "native-dpk-sample", "native-raw-sample"]
      }
    },
    "amortization_count": {"description": "Historical v1 estimate parameter, not authority to discount recipient-required state.", "type": "integer", "minimum": 1, "maximum": 1000000},
    "transport_framing": {"type": "string", "enum": ["included", "unmeasured"]},
    "components": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "consumed_by_sampler",
        "depends_on",
        "executable",
        "handler",
        "id",
        "kind",
        "path",
        "required",
        "role",
        "sha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "role": {
          "type": "string",
          "enum": [
            "dictionary",
            "evidence_authorization",
            "materialized_rows",
            "runtime",
            "sampling_payload",
            "shared_learned_state",
            "transform"
          ]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"description": "Measured wire byte length; precision labels such as q4 never substitute for this count.", "type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "kind": {"type": "string", "enum": ["dpk2", "dpk3", "opaque", "doperaw1"]},
        "required": {"type": "boolean"},
        "consumed_by_sampler": {"type": "boolean"},
        "executable": {"type": "boolean", "const": false},
        "handler": {"type": "string", "const": "none"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
        }
      }
    }
  }
}
