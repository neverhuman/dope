{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/dope/schemas/generator-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "protocol_frozen",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "dope-generator-registry-v1"
    },
    "version": {
      "const": 1
    },
    "protocol_frozen": {
      "const": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_revision",
          "model_version",
          "code_license",
          "weight_license",
          "mode",
          "last_verified",
          "code_sha256",
          "checkpoint_sha256",
          "dependency_closure_sha256",
          "preprocessing_sha256",
          "native_parity_sha256",
          "resource_evidence_sha256",
          "license_review_sha256",
          "contamination_review_sha256",
          "id",
          "display",
          "family",
          "status",
          "panel",
          "tasks",
          "source_url",
          "license_source",
          "context_cap",
          "qualification",
          "adapter"
        ],
        "properties": {
          "source_revision": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "model_version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "code_license": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "weight_license": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "code_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "checkpoint_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "dependency_closure_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "preprocessing_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "native_parity_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "resource_evidence_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "license_review_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "contamination_review_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "specified",
              "source_verified",
              "weights_verified",
              "environment_verified",
              "parity_verified",
              "resource_verified",
              "qualified"
            ]
          },
          "panel": {
            "enum": [
              "core",
              "frontier",
              "control",
              "baseline"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "regression",
                "classification"
              ]
            }
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "license_source": {
            "type": "string",
            "pattern": "^https://"
          },
          "context_cap": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "admission_status",
              "history",
              "rejection_reason"
            ],
            "properties": {
              "state": {
                "enum": [
                  "specified",
                  "source_verified",
                  "weights_verified",
                  "environment_verified",
                  "parity_verified",
                  "resource_verified",
                  "qualified"
                ]
              },
              "admission_status": {
                "enum": [
                  "unqualified",
                  "qualified"
                ]
              },
              "rejection_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "receipt_sha256"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "source_verified",
                        "weights_verified",
                        "environment_verified",
                        "parity_verified",
                        "resource_verified",
                        "qualified"
                      ]
                    },
                    "receipt_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class_path",
              "kwargs",
              "runtime_arguments"
            ],
            "properties": {
              "class_path": {
                "type": "string",
                "pattern": "^research\\.transfer\\.tdl\\.generators\\."
              },
              "kwargs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "copied_rows",
                      "gzip_original",
                      "gaussian_copula",
                      "arf"
                    ]
                  }
                }
              },
              "runtime_arguments": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "binary",
                    "workdir"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
