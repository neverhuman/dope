{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/tdl-golden-v1.schema.json",
  "title": "Transfer golden fixtures: historical v1 and paired T90 v2",
  "description": "Noncitable conformance fixtures, including deliberately invalid evidence for fail-closed tests. No calibration or qualification is established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "citable",
    "component",
    "purpose",
    "input",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "citable": {
      "const": false
    },
    "component": {
      "const": "transfer"
    },
    "purpose": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "null_losses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "real_losses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "synthetic_losses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "targets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "real_gain_lcb": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "absolute_gain_floor": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "relative_gain_floor": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "tau": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "prediction_offset": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "prediction_scale": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "loss_space": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_model_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "constant_target": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "class_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "real_predictions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "anyOf": [
              {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              },
              {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            ]
          }
        },
        "synthetic_predictions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "anyOf": [
              {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              },
              {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            ]
          }
        },
        "null_predictions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "anyOf": [
              {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              },
              {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            ]
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "informative",
            "uninformative",
            "incomplete",
            "failed"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "null_loss": {
          "type": "number"
        },
        "real_loss": {
          "type": "number"
        },
        "synthetic_loss": {
          "type": "number"
        },
        "real_gain": {
          "type": "number"
        },
        "raw_transfer": {
          "type": "number"
        },
        "clipped_transfer": {
          "type": "number"
        },
        "tau": {
          "type": "number"
        },
        "harm_margin": {
          "type": "number"
        },
        "benefit_margin": {
          "type": "number"
        },
        "loss_space": {
          "enum": [
            "original_mse",
            "discrete_log_loss"
          ]
        },
        "query_harm_margin": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "task"
            ]
          }
        }
      }
    }
  ]
}
