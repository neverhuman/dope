{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.invalid/schemas/panel-v1.schema.json",
  "title": "DOPE immutable evaluation panel edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "edition",
    "status",
    "artifact_zoo",
    "real_only_eligibility",
    "mandatory_tasks",
    "mandatory_models",
    "weights",
    "missing_native_qualification",
    "family_average_rescue",
    "edition_policy",
    "resolution",
    "roles",
    "checkpoints",
    "workloads"
  ],
  "properties": {
    "format": {
      "const": "dope-panel-edition-v1"
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "specified_unqualified",
        "qualified"
      ]
    },
    "artifact_zoo": {
      "type": "string",
      "minLength": 1
    },
    "real_only_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "policy"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mandatory_tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "mandatory_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "required": [
        "weighting_frozen_before_generator_outcomes"
      ],
      "properties": {
        "weighting_frozen_before_generator_outcomes": {
          "const": true
        }
      }
    },
    "missing_native_qualification": {
      "const": "blocks_panel_qualified_pass"
    },
    "family_average_rescue": {
      "const": false
    },
    "edition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "recompile_artifact_zoo",
        "overwrite_historical_scores",
        "new_model_edition_evaluates_only_newly_required_cells"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "recompile_artifact_zoo": {
          "const": false
        },
        "overwrite_historical_scores": {
          "const": false
        },
        "new_model_edition_evaluates_only_newly_required_cells": {
          "const": true
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recursive",
        "immutable",
        "role_signature_sha256",
        "conflict_signature_sha256",
        "rights_signature_sha256",
        "signatures_required_before_qualification"
      ],
      "properties": {
        "recursive": {
          "const": true
        },
        "immutable": {
          "const": true
        },
        "role_signature_sha256": {
          "$ref": "#/$defs/digestOrNull"
        },
        "conflict_signature_sha256": {
          "$ref": "#/$defs/digestOrNull"
        },
        "rights_signature_sha256": {
          "$ref": "#/$defs/digestOrNull"
        },
        "signatures_required_before_qualification": {
          "const": true
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workload"
      }
    }
  },
  "$defs": {
    "digestOrNull": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "roleFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_teacher",
        "selection",
        "required_confirmatory",
        "challenger_only",
        "native_recipe_sensitivity"
      ],
      "properties": {
        "compiler_teacher": {
          "type": "boolean"
        },
        "selection": {
          "type": "boolean"
        },
        "required_confirmatory": {
          "type": "boolean"
        },
        "challenger_only": {
          "type": "boolean"
        },
        "native_recipe_sensitivity": {
          "type": "boolean"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "architecture_family",
        "checkpoint_sha256",
        "teacher_lineage_overlap",
        "roles_by_workload",
        "rights_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "architecture_family": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/digestOrNull"
        },
        "teacher_lineage_overlap": {
          "enum": [
            "known_none",
            "overlapping",
            "unknown"
          ]
        },
        "roles_by_workload": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/roleFlags"
          }
        },
        "rights_status": {
          "enum": [
            "reviewed",
            "unresolved",
            "restricted"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "weight",
        "required_models",
        "real_only_eligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "required_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "real_only_eligible": {
          "const": true
        }
      }
    }
  },
