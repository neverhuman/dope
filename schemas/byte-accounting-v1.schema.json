{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:byte-accounting:v1",
  "title": "ByteAccountingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "payload_bytes",
    "section_bytes",
    "framing_bytes",
    "shared_bytes",
    "sampling_closure_bytes",
    "cold_bundle_bytes",
    "amortized_bytes",
    "artifact_sha256"
  ],
  "properties": {
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "section_bytes": {
      "type": [
        "object",
        "null"
      ],
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "framing_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 8,
      "maximum": 9007199254740991
    },
    "shared_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sampling_closure_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cold_bundle_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "amortized_bytes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1.0
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "charge_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_magic",
        "sections",
        "closure_files"
      ],
      "properties": {
        "container_magic": {
          "const": "TDL1"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ManifestEntry"
          }
        },
        "closure_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestEntry"
          }
        }
      }
    },
    "shared_prior_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_pretrained_prior",
        "disclosed_closure_sha256"
      ],
      "properties": {
        "uses_pretrained_prior": {
          "type": "boolean"
        },
        "disclosed_closure_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "ManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "payload_bytes": {
              "not": {
                "type": "null"
              }
            },
            "section_bytes": {
              "not": {
                "type": "null"
              }
            },
            "framing_bytes": {
              "not": {
                "type": "null"
              }
            },
            "shared_bytes": {
              "not": {
                "type": "null"
              }
            },
            "sampling_closure_bytes": {
              "not": {
                "type": "null"
              }
            },
            "cold_bundle_bytes": {
              "not": {
                "type": "null"
              }
            },
            "amortized_bytes": {
              "not": {
                "type": "null"
              }
            },
            "artifact_sha256": {
              "not": {
                "type": "null"
              }
            }
          }
        },
        {
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$"
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "complete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "payload_bytes": {
            "not": {
              "type": "null"
            }
          },
          "section_bytes": {
            "not": {
              "type": "null"
            }
          },
          "framing_bytes": {
            "not": {
              "type": "null"
            }
          },
          "shared_bytes": {
            "not": {
              "type": "null"
            }
          },
          "sampling_closure_bytes": {
            "not": {
              "type": "null"
            }
          },
          "cold_bundle_bytes": {
            "not": {
              "type": "null"
            }
          },
          "amortized_bytes": {
            "not": {
              "type": "null"
            }
          },
          "artifact_sha256": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "incomplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          }
        }
      }
    }
  ],
  "description": "Measured byte fields are always present. Failed/incomplete results retain known values and encode unavailable values as null with a stable reason code."
}
