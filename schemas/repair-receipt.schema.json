{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOPE local repair receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "reason", "common_fixes", "docs_url", "repair_hint"],
  "properties": {
    "purpose": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "common_fixes": {"type": "string", "minLength": 1},
    "docs_url": {"type": "string", "pattern": "^docs/"},
    "repair_hint": {"type": "string", "minLength": 1}
  }
}
