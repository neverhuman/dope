{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:transfer-bound:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "task_id", "contrast_id", "protocol_id", "receipt_id", "upper_z", "pin_source"],
  "properties": {
    "format": {"const": "dope-transfer-bound"},
    "version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contrast_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "upper_z": {"type": "number"},
    "lower_z": {"type": ["number", "null"]},
    "pin_source": {"const": "external"}
  }
}
