{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dope:transfer-execution-plan:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "sources", "attempts"],
  "properties": {
    "format": {"const": "dope-transfer-execution-plan"},
    "version": {"type": "integer", "const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "identity_sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "source_id", "query_id", "charged_queries", "status"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "query_id": {"type": "string", "minLength": 1},
          "charged_queries": {"type": "integer", "minimum": 0},
          "status": {"enum": ["scheduled", "interrupted", "complete"]}
        }
      }
    }
  }
}
