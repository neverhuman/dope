{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/pilot-execution-v1.schema.json",
  "description": "Metadata contract only; schema validity grants no execution, science, custody or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "operation",
    "campaign_id",
    "pins",
    "tasks",
    "methods",
    "byte_caps",
    "learners",
    "contexts",
    "seeds",
    "stages",
    "sample_policies",
    "budget"
  ],
  "properties": {
    "format": {
      "const": "dope-pilot-execution-contract"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "operation": {
      "const": "development_pilot"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "source_tree",
        "environment_sha256",
        "policy_sha256",
        "schedule_sha256",
        "operation_dag_sha256"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schedule_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_dag_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "role",
          "fit_rows",
          "primary_n",
          "input_sha256"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "observational",
              "adverse_mechanism"
            ]
          },
          "fit_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "primary_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "methods": {
      "const": [
        "dope",
        "gaussian_copula",
        "compressed_real_rows"
      ]
    },
    "byte_caps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "learners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "rows"
        ],
        "properties": {
          "context_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "master",
        "substreams"
      ],
      "properties": {
        "encoding": {
          "const": "explicit-hex-uint64-v1"
        },
        "master": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        },
        "substreams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fit",
            "sample_primary",
            "sample_4n",
            "context",
            "learner"
          ],
          "properties": {
            "fit": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            },
            "sample_primary": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            },
            "sample_4n": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            },
            "context": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            },
            "learner": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{16}$"
            }
          }
        }
      }
    },
    "stages": {
      "const": [
        "prepare",
        "compile",
        "reload",
        "sample",
        "learners",
        "drivers",
        "receipt",
        "report"
      ]
    },
    "sample_policies": {
      "const": [
        "primary_n",
        "sensitivity_4n"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_ms",
        "cpu_ms",
        "peak_ram_bytes",
        "disk_bytes",
        "max_attempts"
      ],
      "properties": {
        "wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cpu_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "peak_ram_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  }
}
